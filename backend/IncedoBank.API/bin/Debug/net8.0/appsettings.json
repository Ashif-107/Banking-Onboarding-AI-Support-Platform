{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=incedobank;Username=incedo_user;Password=incedo_local_pass;Include Error Detail=true",
    "Redis": "localhost:6379,password=incedo_redis_pass"
  },

  "Clerk": {
    "Authority": "https://your-clerk-domain.clerk.accounts.dev",
    "Issuer": "https://your-clerk-domain.clerk.accounts.dev",
    "JwksUrl": "https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json"
  },

  "Groq": {
    "ApiKey": "your-groq-api-key-here"
  },

  "HuggingFace": {
    "ApiKey": "your-huggingface-token-here"
  },

  "Cloudflare": {
    "R2": {
      "AccountId": "your-cloudflare-account-id",
      "AccessKeyId": "your-r2-access-key-id",
      "SecretAccessKey": "your-r2-secret-access-key",
      "BucketName": "incedo-bank-docs"
    }
  },

  "Resend": {
    "ApiKey": "your-resend-api-key-here",
    "FromEmail": "noreply@incedobank.com",
    "FromName": "IncedoBank"
  },

  "Meilisearch": {
    "Host": "http://localhost:7700",
    "ApiKey": "incedo_meili_master_key"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
